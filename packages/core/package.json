    "tinyglobby": "^0.2.17",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.5.12"
