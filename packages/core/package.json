  },
  "bugs": {
    "url": "https://github.com/ianchak/stati/issues"
  },
  "homepage": "https://stati.build",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.20.0 || >=24"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "eta": "4.6.0",
