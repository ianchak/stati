<%
  /* The docs navigation. Sections and pages come from stati.docsSections()
     (see helpers/docs.js). Below 1024px it becomes a drawer that the header's
     menu button opens; without JavaScript it stays in the page flow. */
  const sections = stati.docsSections();
  const here = stati.page.url;
  const nav = stati.site.nav ?? [];
%>
<aside id="sidebar" class="sidebar">
  <div class="sidebar-top">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="26" height="26" />
      <span><%= stati.site.title %></span>
    </a>
    <button type="button" class="icon-button" data-menu-close>
      <%~ stati.partials.icon({ name: 'close', size: 20 }) %>
      <span class="sr-only">Close navigation</span>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Documentation">
    <% if (nav.length > 0) { %>
    <ul class="sidebar-main-links" role="list">
      <% for (const item of nav) { %>
      <li><a href="<%= item.url %>"><%= item.label %></a></li>
      <% } %>
    </ul>
    <% } %>

    <% for (const section of sections) { %>
    <div class="sidebar-section">
      <p class="sidebar-heading">
        <% if (section.hasOverview) { %>
        <a href="<%= section.url %>"<% if (stati.isCurrent(section.url, here)) { %> aria-current="page"<% } %>><%= section.title %></a>
        <% } else { %>
        <%= section.title %>
        <% } %>
      </p>
      <ul class="sidebar-list" role="list">
        <% for (const page of section.pages) { %>
        <li>
          <a href="<%= page.url %>"<% if (stati.isCurrent(page.url, here)) { %> aria-current="page"<% } %>><%= page.label %><% if (page.draft) { %> <span class="draft-badge">Draft</span><% } %></a>
        </li>
        <% } %>
      </ul>
    </div>
    <% } %>
  </nav>
</aside>
<div class="sidebar-backdrop" data-menu-close hidden></div>
