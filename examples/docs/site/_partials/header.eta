<%
  /* Top bar on every page. The links come from `nav` in stati.config.js.
     Props: sidebar (false hides the menu button, for pages without a sidebar). */
  const nav = stati.site.nav ?? [];
  const here = stati.page.url;
  const section = stati.docsSection(here);
  const showMenu = stati.props?.sidebar !== false;
%>
<header class="site-header">
  <div class="header-inner">
    <% if (showMenu) { %>
    <button type="button" class="icon-button menu-button" aria-controls="sidebar" aria-expanded="false" data-menu-open>
      <%~ stati.partials.icon({ name: 'menu', size: 20 }) %>
      <span class="sr-only">Open navigation</span>
    </button>
    <% } %>

    <a class="brand" href="/"<% if (here === '/') { %> aria-current="page"<% } %>>
      <img src="/favicon.svg" alt="" width="26" height="26" />
      <span><%= stati.site.title %></span>
    </a>

    <% if (nav.length > 0) { %>
    <nav class="top-nav" aria-label="Main">
      <ul role="list">
        <% for (const item of nav) { %>
        <%
          const covers = Array.isArray(item.match) ? item.match : [];
          const active = stati.isCurrent(item.url, here)
            || (section && (stati.isCurrent(item.url, section.url) || covers.some((url) => stati.isCurrent(url, section.url))));
        %>
        <li><a href="<%= item.url %>"<% if (active) { %> aria-current="true"<% } %>><%= item.label %></a></li>
        <% } %>
      </ul>
    </nav>
    <% } %>

    <div class="header-actions">
      <button type="button" class="search-button" data-search-open hidden>
        <%~ stati.partials.icon({ name: 'search', size: 16 }) %>
        <span class="search-button-label">Search</span>
        <kbd class="search-button-keys" data-search-keys>Ctrl K</kbd>
      </button>

      <button type="button" class="icon-button theme-button" data-theme-toggle hidden>
        <span class="theme-icon-sun"><%~ stati.partials.icon({ name: 'sun', size: 18 }) %></span>
        <span class="theme-icon-moon"><%~ stati.partials.icon({ name: 'moon', size: 18 }) %></span>
        <span class="sr-only">Dark mode</span>
      </button>

      <% if (stati.site.repository) { %>
      <a class="icon-button" href="<%= stati.site.repository %>">
        <%~ stati.partials.icon({ name: 'github', size: 18 }) %>
        <span class="sr-only">Source repository</span>
      </a>
      <% } %>
    </div>
  </div>
</header>
