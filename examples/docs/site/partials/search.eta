<%
  /* The search dialog, opened by the header button, "/" or Ctrl/Cmd+K.
     public/scripts/docs.js loads Stati's search index on first open and fills
     the result list. Without JavaScript the search button stays hidden.
     The section list lets results use the sidebar's section titles. */
  const sectionTitles = stati.helpers.docsSections().map((section) => ({ url: section.url, title: section.title }));
%>
<dialog class="search-dialog" id="search-dialog" aria-label="Search documentation">
  <div class="search-panel">
    <div class="search-field">
      <%~ stati.include('partials/icon', { name: 'search', size: 20 }) %>
      <input
        id="search-input"
        type="search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="search-results"
        aria-label="Search documentation"
        placeholder="Search documentation"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button type="button" class="search-close" data-search-close>
        <span class="search-close-wide">Esc</span>
        <span class="search-close-narrow">Cancel</span>
      </button>
    </div>
    <div class="search-body">
      <p class="search-message" data-search-message>Search every page and heading.</p>
      <ul class="search-results" id="search-results" role="listbox" aria-label="Search results" hidden></ul>
      <p class="sr-only" role="status" aria-live="polite" data-search-status></p>
    </div>
    <script type="application/json" data-search-sections><%~ JSON.stringify(sectionTitles).replace(/</g, '\\u003c') %></script>
    <div class="search-footer" aria-hidden="true">
      <span><kbd><%~ stati.include('partials/icon', { name: 'arrow-up', size: 12 }) %></kbd> <kbd><%~ stati.include('partials/icon', { name: 'arrow-down', size: 12 }) %></kbd> to move</span>
      <span><kbd>Enter</kbd> to open</span>
      <span><kbd>Esc</kbd> to close</span>
    </div>
  </div>
</dialog>
