{
  "name": "my-stati-docs",
  "version": "1.0.0",
  "description": "A documentation site built with Stati",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "stati dev",
    "build": "stati build",
    "build:drafts": "stati build --include-drafts",
    "preview": "stati preview",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:cache": "node -e \"require('node:fs').rmSync('.stati',{recursive:true,force:true})\"",
    "clean": "npm run clean:dist && npm run clean:cache"
  },
  "keywords": [
    "static-site",
    "stati",
    "documentation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@stati/cli": "^1.15.3",
    "@stati/core": "^1.28.0",
    "markdown-it-prism": "^3.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  }
}
