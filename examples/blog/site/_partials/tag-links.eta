<%
  /* Inline list of tag links. Props: tags (array of tag names), label (accessible name). */
  if (!stati.props || !stati.props.tags || stati.props.tags.length === 0) { return; }
%>
<ul class="tag-links" role="list" aria-label="<%= stati.props.label ?? 'Tags' %>">
  <% for (const tag of stati.props.tags) { %>
  <li><a href="<%= stati.tagUrl(tag) %>"><%= tag %></a></li>
  <% } %>
</ul>
