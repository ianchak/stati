<%
  /* A dated list of posts.
     Props:
       posts         pages from stati.collection, stati.pagination or stati.generated (required)
       descriptions  true shows each post's description under its title
       dateStyle     'short' (default), 'long' or 'day' (no year, for lists grouped by year)
       transition    true animates the title into the post page (only where each post is listed once)
     Each post is a page: its front matter is under post.frontMatter. */
  if (!stati.props || !stati.props.posts) { return; }
  const dateStyle = stati.props.dateStyle ?? 'short';
%>
<ol class="post-list" role="list">
  <% for (const post of stati.props.posts) { %>
  <% const { title, description, draft } = post.frontMatter; %>
  <li class="post-row">
    <time datetime="<%= stati.isoDate(post.publishedAt) %>"><%= post.publishedAt ? stati.formatDate(post.publishedAt, dateStyle) : 'Undated' %></time>
    <div>
      <% if (stati.props.transition) { %>
      <a class="post-row-title" href="<%= post.url %>" style="<%= `view-transition-name: post${post.url.replace(/[^a-z0-9]+/gi, '-')}` %>"><%= title %></a>
      <% } else { %>
      <a class="post-row-title" href="<%= post.url %>"><%= title %></a>
      <% } %>
      <% if (draft) { %><span class="draft-label">Draft</span><% } %>
      <% if (stati.props.descriptions && description) { %>
      <p><%= description %></p>
      <% } %>
    </div>
  </li>
  <% } %>
</ol>
