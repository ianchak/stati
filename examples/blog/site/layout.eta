<%
  /* Layout for every page outside site/posts/ (posts use site/posts/layout.eta), and for
     the archive, site/posts/index.md. A page adds a list of posts under its Markdown by
     setting `listing` in its front matter:

       latest   the newest posts: the home page and the 404 page
       archive  every post, grouped by year: site/posts/index.md
       tags     every tag with its number of posts: site/tags/index.md
       tag      the posts with one tag: site/tags/[tag].md, one page per tag

     The posts come from stati.collection. The archive is the index page of site/posts/,
     so that folder is its collection; the other pages name it with `collection: /posts`.
     Stati rebuilds these pages when a post is added, removed, retitled or retagged. */
  const listing = stati.page.listing;
  const pageNumber = stati.pagination?.pageNumber ?? 1;
  const baseHeading = stati.page.heading ?? stati.page.title;
  const heading =
    pageNumber === 1
      ? baseHeading
      : listing === 'latest'
        ? 'Older posts'
        : `${baseHeading}, page ${pageNumber}`;
%>
<!DOCTYPE html>
<html lang="<%= stati.site.defaultLocale || 'en' %>">
  <%~ stati.partials.head %>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <%~ stati.partials.header %>

    <main id="main" class="wrapper">
      <header class="page-header">
        <h1><%= heading %></h1>
      </header>

      <% if (pageNumber === 1 && stati.content.trim()) { %>
        <div class="prose"><%~ stati.content %></div>
      <% } %>

      <% if (listing === 'latest') { %>
        <%
          /* The home page is paginated (`paginate` in site/index.md): stati.pagination holds
             this page's posts, and Stati rebuilds the page when they change. The 404 page lists
             the newest `listingLimit` posts of the whole collection instead. */
          const all = stati.pagination ? [] : (stati.collection?.recentPages ?? []);
          const posts = stati.pagination
            ? stati.pagination.items
            : all.slice(0, stati.page.listingLimit ?? all.length);
        %>
        <section class="listing" aria-labelledby="latest-heading">
          <h2 id="latest-heading" class="listing-heading">
            <%= pageNumber === 1 ? 'Latest posts' : `Page ${pageNumber} of ${stati.pagination.totalPages}` %>
          </h2>
          <% if (posts.length === 0) { %>
            <p class="empty">No posts yet. Add a Markdown file to <code>site/posts/</code> and it appears here.</p>
          <% } else { %>
            <%~ stati.partials['post-list']({ posts, descriptions: true, transition: true }) %>
            <% if (stati.pagination) { %>
              <%~ stati.partials['page-nav']({ pagination: stati.pagination, newer: 'Newer posts', older: 'Older posts' }) %>
            <% } else if (all.length > posts.length) { %>
              <p class="more"><a href="/posts">All <%= all.length %> posts in the archive</a></p>
            <% } %>
            <div class="end-mark" aria-hidden="true"></div>
          <% } %>
        </section>
      <% } %>

      <% if (listing === 'archive') { %>
        <%
          /* Posts grouped by year, newest first */
          const years = [];
          for (const post of stati.collection?.recentPages ?? []) {
            const year = post.publishedAt ? String(post.publishedAt.getUTCFullYear()) : 'Undated';
            const last = years.at(-1);
            if (last && last.year === year) last.posts.push(post);
            else years.push({ year, posts: [post] });
          }
        %>
        <% if (years.length === 0) { %>
          <p class="empty">Nothing in the archive yet.</p>
        <% } %>
        <% for (const group of years) { %>
          <section class="listing year" aria-labelledby="<%= `year-${group.year}` %>">
            <h2 id="<%= `year-${group.year}` %>" class="listing-heading">
              <%= group.year %>
              <span class="count"><%= group.posts.length === 1 ? '1 post' : `${group.posts.length} posts` %></span>
            </h2>
            <%~ stati.partials['post-list']({ posts: group.posts, dateStyle: group.year === 'Undated' ? 'short' : 'day', transition: true }) %>
          </section>
        <% } %>
      <% } %>

      <% if (listing === 'tags') { %>
        <%
          /* Every tag, most used first. Each one's page comes from site/tags/[tag].md, at the
             address stati.slugify gives the tag. */
          const byTag = stati.collection?.pagesByTag ?? {};
          const tags = Object.keys(byTag).sort(
            (a, b) => byTag[b].length - byTag[a].length || a.localeCompare(b),
          );
        %>
        <% if (tags.length === 0) { %>
          <p class="empty">No tags yet. Add <code>tags: ['example']</code> to a post's front matter.</p>
        <% } else { %>
          <ul class="tag-cloud" role="list" aria-label="All tags">
            <% for (const tag of tags) { %>
              <li>
                <a href="<%= `/tags/${stati.slugify(tag)}` %>"><%= tag %></a>
                <span class="count"><%= byTag[tag].length %></span>
              </li>
            <% } %>
          </ul>
        <% } %>
      <% } %>

      <% if (listing === 'tag') { %>
        <%
          /* One tag's posts. stati.generated holds the tag and every post filed under it;
             with more posts than `generate.paginate` allows, stati.pagination holds this page's. */
          const total = stati.generated.items.length;
          const posts = stati.pagination ? stati.pagination.items : stati.generated.items;
        %>
        <section class="listing" aria-labelledby="tag-heading">
          <h2 id="tag-heading" class="listing-heading">
            <span><span class="hash" aria-hidden="true">#</span><%= stati.generated.label %></span>
            <span class="count"><%= total === 1 ? '1 post' : `${total} posts` %></span>
          </h2>
          <%~ stati.partials['post-list']({ posts, descriptions: true }) %>
          <%~ stati.partials['page-nav']({ pagination: stati.pagination, newer: 'Newer posts', older: 'Older posts' }) %>
          <p class="more"><a href="/tags">All tags</a></p>
        </section>
      <% } %>
    </main>

    <%~ stati.partials.footer %>
  </body>
</html>
