<!DOCTYPE html>
<html lang="<%= stati.site.defaultLocale || 'en' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= stati.page.title ? `${stati.page.title} | ${stati.site.title}` : stati.site.title %></title>

    <!-- Essential meta tags -->
    <% if (stati.page.description) { %>
    <meta name="description" content="<%= stati.page.description %>" />
    <% } %>

    <!-- Canonical URL -->
    <link rel="canonical" href="<%= stati.site.baseUrl %><%= stati.page.url %>" />

    <!-- Icon and styles -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="wrapper">
        <a href="/" class="logo">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          <%= stati.site.title %>
        </a>
        <nav aria-label="Main">
          <a href="/" aria-current="<%= stati.page.url === '/' ? 'page' : 'false' %>">Home</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrapper"><%~ stati.content %></main>

    <footer class="site-footer">
      <div class="wrapper">
        <p>&copy; <%= new Date().getFullYear() %> <%= stati.site.title %></p>
        <p>Built with <a href="https://stati.build">Stati</a> v<%= stati.generator.version %></p>
      </div>
    </footer>
  </body>
</html>
