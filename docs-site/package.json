{
  "name": "stati-docs-site",
  "version": "1.0.0",
  "description": "Official Stati documentation site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "stati dev --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "dev:local": "node ../packages/cli/dist/cli.js dev --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "build": "stati build --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "build:local": "node ../packages/cli/dist/cli.js build --clean --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "build:local:metrics": "node ../packages/cli/dist/cli.js build --clean --metrics --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "build:local:metrics:detailed": "node ../packages/cli/dist/cli.js build --clean --metrics --metrics-detailed --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "build:local:metrics:html": "node ../packages/cli/dist/cli.js build --clean --metrics --metrics-html --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "build:local:metrics:full": "node ../packages/cli/dist/cli.js build --clean --metrics --metrics-detailed --metrics-html --tailwind-input src/styles.css --tailwind-output dist/styles.css",
    "preview": "stati preview",
    "preview:local": "node ../packages/cli/dist/cli.js preview",
    "invalidate": "stati invalidate",
    "invalidate:local": "node ../packages/cli/dist/cli.js invalidate",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:cache": "node -e \"require('node:fs').rmSync('.stati',{recursive:true,force:true})\"",
    "clean": "npm run clean:dist && npm run clean:cache",
    "typecheck": "tsc --noEmit && npm run check:snippets",
    "check:snippets": "node scripts/check-snippets.mjs"
  },
  "keywords": [
    "static-site",
    "stati",
    "minimal"
  ],
  "stati": {
    "engine": "stati",
    "version": "2.8.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@stati/cli": "2.4.1",
    "@stati/core": "2.10.0",
    "@stati/images": "1.1.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/prismjs": "1.26.6",
    "js-yaml": "4.3.2",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-external-links": "0.0.6",
    "markdown-it-prism": "4.0.0",
    "prismjs": "1.30.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.20.0 || >=24"
  },
  "dependencies": {
    "flexsearch": "0.8.212"
  }
}
