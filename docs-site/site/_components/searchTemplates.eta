<%
/**
 * Search Templates Component
 *
 * Hidden HTML templates for the client-side search functionality.
 * These templates are cloned and populated by search-ui.ts at runtime.
 *
 * Templates:
 *   - search-container: The main dropdown container (desktop)
 *   - search-mobile-modal: Full-screen search modal (mobile)
 *   - search-loading: Loading state
 *   - search-no-results: No results found state
 *   - search-error: Error state
 *   - search-results: Results wrapper with header and footer
 *   - search-result-item: Individual result item
 *
 * Usage:
 *   Include in layout: <%~ stati.partials.searchTemplates %>
 *
 * Tailwind safelist (used dynamically via JS):
 *   bg-primary-50 dark:bg-primary-900/20
 */
%>

<!-- Search Modal (mobile full-screen, desktop centered dialog) -->
<div id="mobile-search-modal" class="fixed inset-0 z-[9000] hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-close-modal></div>
    <!-- Modal content -->
    <div class="relative flex flex-col h-full lg:h-auto lg:w-full lg:max-w-2xl lg:mx-auto lg:mt-[14vh] lg:rounded-2xl lg:shadow-2xl lg:border lg:border-slate-200/70 dark:lg:border-slate-700/60 lg:overflow-hidden bg-docs-surface">
        <!-- Header with input -->
        <div class="flex items-center gap-3 px-4 py-3.5 border-b border-slate-200 dark:border-slate-700">
            <span class="text-slate-400 flex-shrink-0">
                <%~ stati.partials.icon({ name: 'search', size: 'md', strokeWidth: 1.5 }) %>
            </span>
            <input id="mobile-search-input"
                   type="search"
                   placeholder="Search documentation..."
                   class="flex-1 bg-transparent text-base text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none min-h-10"
                   autocomplete="off"
                   spellcheck="false">
            <div class="hidden lg:flex items-center gap-1 flex-shrink-0 text-slate-400">
                <kbd class="text-[11px]">esc</kbd>
            </div>
            <button data-close-modal class="lg:hidden inline-flex min-h-10 min-w-10 items-center justify-center p-2 -mr-1 text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors duration-150">
                <%~ stati.partials.icon({ name: 'close', size: 'md', strokeWidth: 1.5 }) %>
            </button>
        </div>
        <!-- Results container -->
        <div id="mobile-search-results" class="flex-1 overflow-y-auto lg:max-h-[60vh]"></div>
    </div>
</div>

<!-- Search Dropdown Container (Desktop) -->
<template id="search-container-template">
    <div id="search-results"
         class="fixed w-[600px] bg-docs-surface/95 backdrop-blur-xl border border-docs-border rounded-2xl shadow-2xl shadow-gray-900/20 dark:shadow-black/50 overflow-hidden hidden"
         style="z-index: 9999;"
         role="listbox"
         aria-label="Search results">
    </div>
</template>

<!-- Loading State -->
<template id="search-loading-template">
    <div class="p-6 text-center">
        <div class="inline-flex items-center gap-2 text-docs-text-muted">
            <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-sm">Searching...</span>
        </div>
    </div>
</template>

<!-- No Results State -->
<template id="search-no-results-template">
    <div class="p-8 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-docs-surface-muted mb-3 text-docs-text-muted">
            <%~ stati.partials.icon({ name: 'search', size: 'lg', strokeWidth: 1.5 }) %>
        </div>
        <p class="text-sm text-docs-text-muted">
            No results found for "<span data-search-query class="font-medium text-docs-text-strong"></span>"
        </p>
        <p class="text-xs text-docs-text-muted mt-1">Try different keywords</p>
    </div>
</template>

<!-- Error State -->
<template id="search-error-template">
    <div class="p-8 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-docs-surface-muted mb-3 text-primary-600 dark:text-primary-400">
            <%~ stati.partials.icon({ name: 'close', size: 'lg', strokeWidth: 1.5 }) %>
        </div>
        <p class="text-sm text-docs-text-strong font-medium">Search failed</p>
        <p class="text-xs text-docs-text-muted mt-1">Please try again</p>
    </div>
</template>

<!-- Results Wrapper (header + list + footer) -->
<template id="search-results-template">
    <div class="search-results-wrapper">
        <!-- Header -->
        <div class="px-4 py-3 border-b border-docs-border bg-docs-surface-muted/70">
            <p data-results-count class="text-xs font-medium text-docs-text-muted"></p>
        </div>

        <!-- Results List -->
        <ul class="max-h-[400px] overflow-y-auto"></ul>

        <!-- Footer -->
        <div class="px-4 py-3 border-t border-docs-border bg-docs-surface-muted/70 flex items-center justify-between">
            <div class="flex items-center gap-5 text-xs text-docs-text-muted">
                <span class="inline-flex items-center gap-2">
                    <kbd class="inline-flex items-center justify-center min-w-[24px] px-1.5 py-1 bg-docs-surface rounded-md border border-docs-border font-mono text-[10px] text-docs-text-muted shadow-sm">↑↓</kbd>
                    <span class="text-docs-text-muted">Navigate</span>
                </span>
                <span class="inline-flex items-center gap-2">
                    <kbd class="inline-flex items-center justify-center min-w-[24px] px-1.5 py-1 bg-docs-surface rounded-md border border-docs-border font-mono text-[10px] text-docs-text-muted shadow-sm">↵</kbd>
                    <span class="text-docs-text-muted">Select</span>
                </span>
                <span class="inline-flex items-center gap-2">
                    <kbd class="inline-flex items-center justify-center min-w-[24px] px-1.5 py-1 bg-docs-surface rounded-md border border-docs-border font-mono text-[10px] text-docs-text-muted shadow-sm">esc</kbd>
                    <span class="text-docs-text-muted">Close</span>
                </span>
            </div>
            <div class="flex items-center gap-1.5 text-[11px]">
                <span class="text-docs-text-muted">Powered by</span>
                <span class="font-semibold text-docs-text-strong">Stati</span>
            </div>
        </div>
    </div>
</template>

<!-- Result Item - Page -->
<template id="search-page-item-template">
    <li role="option"
        class="search-result-item group px-4 py-3 hover:bg-primary-50/50 dark:hover:bg-primary-900/20 transition-[background-color,color,opacity] duration-150 border-b border-docs-border/70 last:border-b-0"
        style="cursor: pointer;"
        aria-selected="false">
        <div class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-0.5 p-1.5 rounded-lg bg-docs-surface-muted text-docs-text-muted group-hover:bg-primary-100 dark:group-hover:bg-primary-900/30 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-150">
                <%~ stati.partials.icon({ name: 'document', size: 'sm', strokeWidth: 1.5 }) %>
            </div>
            <div class="flex-1 min-w-0">
                <div data-result-heading class="text-sm font-medium text-docs-text-strong group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors duration-150"></div>
                <div class="text-xs text-docs-text-muted mt-0.5 flex items-center gap-1">
                    <%~ stati.partials.icon({ name: 'folder', size: 'xs', class: 'flex-shrink-0', strokeWidth: 1.5 }) %>
                    <span data-result-breadcrumb class="truncate"></span>
                </div>
                <p data-result-snippet class="text-xs text-docs-text-muted mt-1.5 line-clamp-2 leading-relaxed"></p>
            </div>
            <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                <%~ stati.partials.icon({ name: 'chevron-right', size: 'sm', class: 'text-docs-text-muted', strokeWidth: 1.5 }) %>
            </div>
        </div>
    </li>
</template>

<!-- Result Item - Section -->
<template id="search-section-item-template">
    <li role="option"
        class="search-result-item group px-4 py-3 hover:bg-primary-50/50 dark:hover:bg-primary-900/20 transition-[background-color,color,opacity] duration-150 border-b border-docs-border/70 last:border-b-0"
        style="cursor: pointer;"
        aria-selected="false">
        <div class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-0.5 p-1.5 rounded-lg bg-docs-surface-muted text-docs-text-muted group-hover:bg-primary-100 dark:group-hover:bg-primary-900/30 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-150">
                <%~ stati.partials.icon({ name: 'code', size: 'sm', strokeWidth: 1.5 }) %>
            </div>
            <div class="flex-1 min-w-0">
                <div data-result-heading class="text-sm font-medium text-docs-text-strong group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors duration-150"></div>
                <div class="text-xs text-docs-text-muted mt-0.5 flex items-center gap-1">
                    <%~ stati.partials.icon({ name: 'folder', size: 'xs', class: 'flex-shrink-0', strokeWidth: 1.5 }) %>
                    <span data-result-breadcrumb class="truncate"></span>
                </div>
                <p data-result-snippet class="text-xs text-docs-text-muted mt-1.5 line-clamp-2 leading-relaxed"></p>
            </div>
            <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                <%~ stati.partials.icon({ name: 'chevron-right', size: 'sm', class: 'text-docs-text-muted', strokeWidth: 1.5 }) %>
            </div>
        </div>
    </li>
</template>
