<%
/**
 * ISG Tab Content
 *
 * Content for the Incremental Static Generation feature tab.
 *
 * Props:
 *   - active (optional): Boolean, is this tab active (default: false)
 */

const active = stati.props?.active || false;
%>
<div class="<%= stati.propValue('feature-content h-full p-6 lg:p-10', active ? 'active' : 'hidden') %>"
     id="proof-panel-isg"
     data-content="isg"
     role="tabpanel"
     aria-labelledby="proof-tab-isg"
     aria-hidden="<%= active ? 'false' : 'true' %>">
    <div class="grid lg:grid-cols-2 gap-8 items-start h-full">
        <div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                Incremental cache controls
            </h3>
            <p class="text-base text-gray-600 dark:text-gray-300 mb-6">
                Cache entries store dependencies, timestamps, and TTL so rebuild work stays targeted.
            </p>
            <ul class="space-y-3">
                <%~ stati.partials.highlightItem({ text: 'Manifest tracks output path, input hash, deps, and TTL' }) %>
                <%~ stati.partials.highlightItem({ text: 'Invalidate by path, tag, or content age query' }) %>
                <%~ stati.partials.highlightItem({ text: 'Aging rules increase TTL for older content safely' }) %>
            </ul>
            <%~ stati.partials.button({
                href: '/configuration/isg/',
                text: 'ISG configuration',
                variant: 'secondary',
                icon: 'chevron-right',
                class: 'mt-8'
            }) %>
        </div>
        <div class="relative">
            <pre class="language-json rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-json">{
  "index.md": {
    "path": "index.html",
    "inputsHash": "8413a9...",
    "deps": ["site/_home/highlights.eta"],
    "ttlSeconds": 900,
    "renderedAt": "2026-07-14T06:41:12.000Z"
  }
}</code></pre>
            <div class="mt-4">
                <pre class="language-bash rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-bash">stati invalidate tag:news
stati invalidate age:3months
stati invalidate path:/api/*</code></pre>
            </div>
        </div>
    </div>
</div>
