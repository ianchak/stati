<%
/**
 * Build Path Section (Homepage)
 *
 * Real content-to-cache pipeline band.
 */
const buildPath = stati.page.buildPath || {};
const stepsInput = Array.isArray(buildPath.steps) ? buildPath.steps : [];
const fallbackSteps = [
  { token: 'site/*.md', label: 'content', detail: 'read Markdown and frontmatter' },
  { token: 'markdown-it', label: 'transform', detail: 'convert Markdown to HTML' },
  { token: '.eta', label: 'compose', detail: 'apply templates and partials' },
  { token: 'dist/*.html', label: 'emit', detail: 'write static pages' },
  { token: '.stati/cache', label: 'reuse', detail: 'persist incremental build state' },
];
const steps = stepsInput.length === 5 ? stepsInput : fallbackSteps;
%>
<section class="docs-build-path" aria-labelledby="build-path-title">
    <div class="docs-build-path__inner">
        <header class="docs-build-path__heading">
            <h2 id="build-path-title" class="docs-build-path__title">
                <%= buildPath.title || 'From source content to reusable output.' %>
            </h2>
            <p class="docs-build-path__subtitle">
                <%= buildPath.subtitle || 'Each stage maps to the real Stati pipeline.' %>
            </p>
        </header>

        <ol class="docs-build-path__list" aria-label="Stati build pipeline">
            <% for (const step of steps) { %>
                <li class="docs-build-path__step">
                    <p class="docs-build-path__token"><code><%= step.token %></code></p>
                    <p class="docs-build-path__label"><%= step.label %></p>
                    <p class="docs-build-path__detail"><%= step.detail %></p>
                </li>
            <% } %>
        </ol>
    </div>
</section>
