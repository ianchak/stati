<%
/**
 * Templates Tab Content
 *
 * Content for the Eta Templates feature tab.
 *
 * Props:
 *   - active (optional): Boolean, is this tab active (default: false)
 */

const active = stati.props?.active || false;
%>
<div class="<%= stati.propValue('feature-content h-full p-6 lg:p-10', active ? 'active' : 'hidden') %>"
     id="proof-panel-templates"
     data-content="templates"
     role="tabpanel"
     aria-labelledby="proof-tab-templates"
     aria-hidden="<%= active ? 'false' : 'true' %>">
    <div class="grid lg:grid-cols-2 gap-8 items-start h-full">
        <div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                Eta layout composition
            </h3>
            <p class="text-base text-gray-600 dark:text-gray-300 mb-6">
                Layout inheritance and callable partials keep shared structure explicit and reusable.
            </p>
            <ul class="space-y-3">
                <%~ stati.partials.highlightItem({ text: 'Page templates resolve nearest parent <code class="text-sm bg-gray-100 dark:bg-dark-700 px-2 py-1 rounded">layout.eta</code>' }) %>
                <%~ stati.partials.highlightItem({ text: 'Partials in underscore folders can be included from any page' }) %>
                <%~ stati.partials.highlightItem({ text: 'Callable partials receive typed props through <code class="text-sm bg-gray-100 dark:bg-dark-700 px-2 py-1 rounded">stati.props</code>' }) %>
            </ul>
            <%~ stati.partials.button({
                href: '/core-concepts/templates/',
                text: 'Template reference',
                variant: 'secondary',
                icon: 'chevron-right',
                class: 'mt-8'
            }) %>
        </div>
        <div class="relative">
            <pre class="language-html rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-html">&lt;!-- site/blog/layout.eta --&gt;
&lt;main class="docs-shell"&gt;
  &lt;%~ include('../_sections/header') %&gt;
  &lt;article&gt;&lt;%~ stati.content %&gt;&lt;/article&gt;
&lt;/main&gt;

&lt;%~ stati.partials.callout({
  title: 'ISG cache note',
  body: 'Use tag invalidation for grouped updates.'
}) %&gt;</code></pre>
        </div>
    </div>
</div>
