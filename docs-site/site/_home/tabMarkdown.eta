<%
/**
 * Markdown Tab Content
 *
 * Content for the Enhanced Markdown Pipeline feature tab.
 *
 * Props:
 *   - active (optional): Boolean, is this tab active (default: false)
 */

const active = stati.props?.active || false;
%>
<div class="<%= stati.propValue('feature-content h-full p-6 lg:p-10', active ? 'active' : 'hidden') %>"
     id="proof-panel-markdown"
     data-content="markdown"
     role="tabpanel"
     aria-labelledby="proof-tab-markdown"
     aria-hidden="<%= active ? 'false' : 'true' %>">
    <div class="grid lg:grid-cols-2 gap-8 items-start h-full">
        <div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                Markdown to HTML pipeline
            </h3>
            <p class="text-base text-gray-600 dark:text-gray-300 mb-6">
                markdown-it drives parsing, while plugins and TOC extraction shape final output.
            </p>
            <ul class="space-y-3">
                <%~ stati.partials.highlightItem({ text: 'Frontmatter and body are parsed in one pass' }) %>
                <%~ stati.partials.highlightItem({ text: 'Plugin tuples configure markdown-it behavior' }) %>
                <%~ stati.partials.highlightItem({ text: 'TOC extraction can be toggled per project config' }) %>
            </ul>
            <%~ stati.partials.button({
                href: '/core-concepts/markdown/',
                text: 'Markdown reference',
                variant: 'secondary',
                icon: 'chevron-right',
                class: 'mt-8'
            }) %>
        </div>
        <div class="relative">
            <pre class="language-markdown rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-markdown">---
title: Core Concepts
layout: docs
tags: ['reference']
---

# Markdown Pipeline

Use **Markdown** for content and keep config in TypeScript.

```ts
markdown: {
  toc: true,
  plugins: [['external-links', { externalTarget: '_blank' }]]
}
```</code></pre>
        </div>
    </div>
</div>
