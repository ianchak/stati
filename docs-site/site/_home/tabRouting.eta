<%
/**
 * Routing Tab Content
 *
 * Content for the Filesystem-Based Routing feature tab.
 *
 * Props:
 *   - active (optional): Boolean, is this tab active (default: false)
 */

const active = stati.props?.active || false;
%>
<div class="<%= stati.propValue('feature-content h-full p-6 lg:p-10', active ? 'active' : 'hidden') %>"
     id="proof-panel-routing"
     data-content="routing"
     role="tabpanel"
     aria-labelledby="proof-tab-routing"
     aria-hidden="<%= active ? 'false' : 'true' %>">
    <div class="grid lg:grid-cols-2 gap-8 items-start h-full">
        <div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                File-to-route mapping
            </h3>
            <p class="text-base text-gray-600 dark:text-gray-300 mb-6">
                Content paths map directly to output URLs, with explicit escape hatches when needed.
            </p>
            <ul class="space-y-3">
                <%~ stati.partials.highlightItem({ text: 'Nested folders create nested routes by default' }) %>
                <%~ stati.partials.highlightItem({ text: 'Underscore folders are excluded from route generation' }) %>
                <%~ stati.partials.highlightItem({ text: 'Frontmatter <code class="text-sm bg-gray-100 dark:bg-dark-700 px-2 py-1 rounded">permalink</code> overrides the computed URL' }) %>
            </ul>
            <%~ stati.partials.button({
                href: '/core-concepts/routing/',
                text: 'Routing reference',
                variant: 'secondary',
                icon: 'chevron-right',
                class: 'mt-8'
            }) %>
        </div>
        <div class="relative space-y-4">
            <pre class="language-text rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-text">site/
├── index.md                   → /
├── getting-started/intro.md   → /getting-started/intro/
└── api/reference.md           → /api/reference/</code></pre>
            <pre class="language-markdown rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-markdown">---
title: API Overview
permalink: /reference/
---
</code></pre>
            <pre class="language-text rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-text">dist/
└── reference/
    └── index.html</code></pre>
            <pre class="language-markdown rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-markdown"># Underscore exclusion
---
_partials/
_components/
---
Ignored by router</code></pre>
        </div>
    </div>
</div>
