<%
/**
 * Claims Section (Homepage)
 *
 * The three positioning claims, each proven with real code. The ISG claim
 * adds an illustrative rebuild log that plays once when it scrolls into view
 * (src/home/rebuild-log.ts). Content lives in index.md front matter.
 */

// Pre-rendered on every page: render nothing where the homepage data is absent
if (!stati.page.claims) { %><% return; } %>
<%
const claims = stati.page.claims;
%>
<section class="border-b border-line" aria-labelledby="claims-title">
    <div class="mx-auto max-w-page px-4 py-20 sm:px-6 lg:py-28">
        <h2 id="claims-title" class="max-w-3xl font-display text-[clamp(2rem,1.4rem+2vw,3rem)] font-extrabold leading-[1.05] [font-stretch:115%]"><%= claims.title %></h2>

        <div class="mt-14 divide-y divide-line border-t border-line">
            <% claims.items.forEach(claim => { %>
            <article id="<%= `claim-${claim.id}` %>" class="grid grid-cols-1 gap-8 py-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:py-16" aria-labelledby="<%= `claim-${claim.id}-title` %>">
                <div class="lg:sticky lg:top-24 lg:self-start">
                    <h3 id="<%= `claim-${claim.id}-title` %>" class="font-display text-2xl font-bold leading-tight [font-stretch:110%]"><%= claim.title %></h3>
                    <p class="mt-4 leading-7 text-muted"><%= claim.text %></p>
                    <a href="<%= claim.link.href %>" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink hover:underline hover:underline-offset-4">
                        <%= claim.link.text %>
                        <%~ stati.partials.icon({ name: 'arrow-right', size: 'sm' }) %>
                    </a>
                </div>

                <div class="ticks grid min-w-0 grid-cols-1 gap-4">
                    <% claim.panels.forEach((panel, i) => { %>
                    <%~ stati.partials.codePanel({ id: `claim-${claim.id}-${i}`, file: panel.file, lang: panel.lang, code: panel.code, ticks: false }) %>
                    <% }) %>

                    <% if (claim.log) { %>
                    <figure class="code-panel m-0" data-rebuild-log>
                        <figcaption class="code-panel-bar">
                            <span>stati build</span>
                            <span class="font-sans" data-log-summary><%= claim.log.rows.filter(r => r.status === 'rebuilt').length %> rebuilt · <%= claim.log.rows.filter(r => r.status === 'cached').length %> cached</span>
                        </figcaption>
                        <table class="w-full font-mono text-[13px]">
                            <caption class="sr-only"><%= claim.log.caption %></caption>
                            <thead class="sr-only">
                                <tr><th scope="col">Page</th><th scope="col">Result</th><th scope="col">Reason</th></tr>
                            </thead>
                            <tbody>
                                <% claim.log.rows.forEach(row => { %>
                                <tr class="log-row border-b border-line last:border-0" data-status="<%= row.status %>">
                                    <td class="py-2 pl-4 pr-2 text-ink sm:pl-5">
                                        <%= row.path %>
                                        <span class="mt-0.5 block font-sans text-xs text-muted sm:hidden"><%= row.reason %></span>
                                    </td>
                                    <td class="whitespace-nowrap px-2 py-2 align-top sm:align-middle">
                                        <span class="<%= stati.propValue('inline-flex items-center gap-2', row.status === 'rebuilt' ? 'text-ink' : 'text-faint') %>">
                                            <span class="<%= stati.propValue('h-1.5 w-1.5 flex-none', row.status === 'rebuilt' ? 'bg-ink' : 'rounded-full border border-current') %>" aria-hidden="true"></span>
                                            <%= row.status %>
                                        </span>
                                    </td>
                                    <td class="hidden py-2 pl-2 pr-4 font-sans text-xs text-muted sm:table-cell sm:pr-5"><%= row.reason %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                        <p class="border-t border-line px-4 py-2 font-sans text-xs text-faint sm:px-5"><%= claim.log.caption %></p>
                    </figure>
                    <% } %>
                </div>
            </article>
            <% }) %>
        </div>
    </div>
</section>
