<%
/**
 * Quick Start Section (Homepage)
 *
 * Sparse command close with one action vocabulary.
 */
const quickStart = stati.page.quickStart || {};
const command =
  quickStart.command ||
  quickStart.commands?.[0]?.text ||
  quickStart.commands?.[0]?.parts?.map((part) => part.text).join(' ') ||
  'npx create-stati';
%>
<section class="py-16 md:py-20 lg:py-24 bg-[var(--docs-surface-muted)]" aria-labelledby="command-close-title">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="max-w-[65ch]">
            <h2 id="command-close-title" class="m-0 text-3xl font-bold tracking-tight text-[var(--docs-text-strong)] md:text-4xl">
                <%= quickStart.title || 'One command. A real project.' %>
            </h2>
            <% if (quickStart.subtitle) { %>
            <p class="mt-4 mb-0 text-lg text-[var(--docs-text-muted)]">
                <%= quickStart.subtitle %>
            </p>
            <% } %>
        </div>

        <div class="mt-8 rounded-2xl border border-gray-200 dark:border-dark-600 bg-white dark:bg-dark-900 shadow-soft">
            <div class="px-6 py-5 lg:px-8 lg:py-6">
                <p class="m-0 text-sm font-semibold uppercase tracking-[0.08em] text-[var(--docs-text-muted)]">
                    Scaffold command
                </p>
                <pre class="mt-3 mb-0 overflow-x-auto"><code class="font-mono text-base text-[var(--docs-text-strong)]"><%= command %></code></pre>
            </div>
            <% if (quickStart.note) { %>
            <div class="border-t border-gray-200 dark:border-dark-600 px-6 py-4 lg:px-8 text-sm text-[var(--docs-text-muted)]">
                <%= quickStart.note %>
            </div>
            <% } %>
        </div>

        <% if (quickStart.link) { %>
        <div class="mt-8">
            <%~ stati.partials.button({
                href: quickStart.link.url,
                text: quickStart.link.text || 'Get started',
                variant: 'primary',
                icon: 'arrow-right'
            }) %>
        </div>
        <% } %>
    </div>
</section>
