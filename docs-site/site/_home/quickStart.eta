<%
/**
 * Start Section (Homepage)
 *
 * Closing call to action: the install command again, plus next steps.
 */

// Pre-rendered on every page: render nothing where the homepage data is absent
if (!stati.page.start || !stati.page.hero) { %><% return; } %>
<%
const start = stati.page.start;
%>
<section class="relative overflow-hidden" aria-labelledby="start-title">
    <div class="relative mx-auto max-w-2xl px-4 py-24 text-center sm:px-6 lg:py-32">
        <h2 id="start-title" class="font-display text-[clamp(2rem,1.4rem+2vw,3rem)] font-extrabold leading-[1.05] [font-stretch:115%]"><%= start.title %></h2>
        <p class="mx-auto mt-4 max-w-lg leading-7 text-muted"><%= start.text %></p>
        <div class="mx-auto mt-9 max-w-sm text-left">
            <%~ stati.partials.commandLine({ id: 'start-command', command: stati.page.hero.command }) %>
        </div>
        <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            <% start.links.forEach(link => { %>
            <li><a href="<%= link.href %>" class="inline-flex items-center gap-1 font-medium text-accent-ink hover:underline hover:underline-offset-4"><%= link.text %><%~ stati.partials.icon({ name: 'arrow-right', size: 'xs' }) %></a></li>
            <% }) %>
        </ul>
    </div>
</section>
