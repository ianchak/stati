<%
/**
 * Features Section (Homepage)
 *
 * Capability module map in a 12-column asymmetric layout.
 */
const features = stati.page.features || {};
const itemsInput = Array.isArray(features.items) ? features.items : [];
const fallbackItems = [
  {
    title: 'TypeScript-first bundle routing',
    description: 'Typed bundle definitions keep route-level JavaScript explicit.',
    span: 'large',
    artifact: {
      label: 'typescript.bundles[]',
      lines: ["{ entryPoint: 'home.ts', bundleName: 'home', include: ['index.md'] }"],
    },
  },
  {
    title: 'ISG cache manifest',
    description: 'Incremental rebuild state is persisted and queried by path, tags, and age.',
    span: 'large',
    artifact: {
      label: '.stati/cache/manifest.json',
      lines: ['{ "path": "index.html", "ttlSeconds": 900, "tags": ["docs"] }'],
    },
  },
  {
    title: 'Filesystem routing',
    description: 'Content structure maps directly to output routes.',
    artifact: { label: 'Route path', value: '/core-concepts/isg/index.html' },
  },
  {
    title: 'Markdown transform',
    description: 'markdown-it plus plugins handles headings, links, and syntax output.',
    artifact: { label: 'Config fragment', value: "markdown: { plugins: [['external-links', { externalTarget: '_blank' }]] }" },
  },
  {
    title: 'Configuration surface',
    description: 'defineConfig keeps site, markdown, ISG, and SEO settings in one typed file.',
  },
  {
    title: 'Tooling workflow',
    description: 'Scaffold, build, and invalidate through documented CLI commands.',
    artifact: { label: 'CLI command', value: 'stati invalidate tag:news' },
  },
];
const modules = itemsInput.length === 6 ? itemsInput : fallbackItems;
%>
<section class="docs-capabilities" aria-labelledby="capabilities-title">
    <div class="docs-capabilities__inner">
        <header class="docs-capabilities__heading">
            <h2 id="capabilities-title" class="docs-capabilities__title">
                <%= features.title || 'The build stays understandable.' %>
            </h2>
            <p class="docs-capabilities__subtitle">
                <%= features.subtitle || 'Six modules map the real Stati feature set with implementation artifacts.' %>
            </p>
        </header>

        <div class="docs-capabilities__grid" role="list" aria-label="Stati capabilities">
            <% for (const module of modules) { %>
                <article role="listitem" class="<%= stati.propValue('docs-capability', module.span === 'large' && 'docs-capability--large') %>">
                    <h3 class="docs-capability__title"><%= module.title %></h3>
                    <p class="docs-capability__description"><%= module.description %></p>

                    <% if (module.artifact) { %>
                        <div class="docs-capability__artifact" aria-label="Implementation artifact">
                            <p class="docs-capability__artifact-label"><%= module.artifact.label %></p>
                            <% if (Array.isArray(module.artifact.lines) && module.artifact.lines.length > 0) { %>
                                <pre class="docs-capability__artifact-code"><code><%= module.artifact.lines.join('\n') %></code></pre>
                            <% } else if (module.artifact.value) { %>
                                <code class="docs-capability__artifact-value"><%= module.artifact.value %></code>
                            <% } %>
                        </div>
                    <% } %>
                </article>
            <% } %>
        </div>
    </div>
</section>
