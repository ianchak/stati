<%
/**
 * TypeScript Tab Content
 *
 * Content for the TypeScript-First feature tab.
 *
 * Props:
 *   - active (optional): Boolean, is this tab active (default: false)
 */

const active = stati.props?.active || false;
%>
<div class="<%= stati.propValue('feature-content h-full p-6 lg:p-10', active ? 'active' : 'hidden') %>"
     id="proof-panel-typescript"
     data-content="typescript"
     role="tabpanel"
     aria-labelledby="proof-tab-typescript"
     aria-hidden="<%= active ? 'false' : 'true' %>">
    <div class="grid lg:grid-cols-2 gap-8 items-start h-full">
        <div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                Typed bundle configuration
            </h3>
            <p class="text-base text-gray-600 dark:text-gray-300 mb-6">
                Define route-targeted bundles with typed config and explicit include patterns.
            </p>
            <ul class="space-y-3">
                <%~ stati.partials.highlightItem({ text: 'Typed <code class="text-sm bg-gray-100 dark:bg-dark-700 px-2 py-1 rounded">defineConfig()</code> contract for bundle entries' }) %>
                <%~ stati.partials.highlightItem({ text: 'Route include and exclude globs control delivery targets' }) %>
                <%~ stati.partials.highlightItem({ text: 'Generated assets are exposed through <code class="text-sm bg-gray-100 dark:bg-dark-700 px-2 py-1 rounded">stati.assets.bundlePaths</code>' }) %>
            </ul>
            <%~ stati.partials.button({
                href: '/configuration/typescript/',
                text: 'TypeScript configuration',
                variant: 'secondary',
                icon: 'chevron-right',
                class: 'mt-8'
            }) %>
        </div>
        <div class="relative">
            <pre class="language-typescript rounded-xl overflow-hidden shadow-md shadow-gray-900/5 dark:shadow-black/10"><code class="language-typescript">import { defineConfig } from '@stati/core';

export default defineConfig({
  typescript: {
    enabled: true,
    bundles: [
      {
        entryPoint: 'home.ts',
        bundleName: 'home',
        include: ['index.md'],
      },
      {
        entryPoint: 'docs.ts',
        bundleName: 'docs',
        exclude: ['index.md'],
      },
    ],
  },
});</code></pre>
        </div>
    </div>
</div>
