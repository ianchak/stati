<%
/**
 * Highlights Section (Homepage)
 *
 * Proof-desk composition with accessible tabs.
 */
const tabs = [
  { id: 'typescript', label: 'TypeScript-first build' },
  { id: 'isg', label: 'ISG cache behavior' },
  { id: 'templates', label: 'Eta template rendering' },
  { id: 'routing', label: 'Route mapping' },
  { id: 'markdown', label: 'Markdown transform' },
];
%>
<section class="py-16 md:py-20 lg:py-24 bg-[var(--docs-surface)]" aria-labelledby="proof-desk-title">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <header class="mb-10 max-w-[65ch]">
            <h2 id="proof-desk-title" class="m-0 text-3xl font-bold tracking-tight text-[var(--docs-text-strong)] md:text-4xl">
                See each layer work.
            </h2>
            <p class="mt-4 mb-0 text-lg text-[var(--docs-text-muted)]">
                Five real demonstrations share one tab system, keyboard flow, and proof surface.
            </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-5">
            <aside class="md:col-span-3">
                <div class="-mx-2 px-2 flex gap-2 overflow-x-auto snap-x snap-mandatory md:mx-0 md:px-0 md:flex-col md:overflow-visible md:snap-none"
                     role="tablist"
                     aria-label="Proof demonstrations">
                    <% tabs.forEach((tab, i) => { %>
                        <%~ stati.partials.highlightTab({
                            id: tab.id,
                            label: tab.label,
                            active: i === 0
                        }) %>
                    <% }) %>
                </div>
            </aside>

            <div class="md:col-span-9 rounded-2xl border border-gray-200 dark:border-dark-600 bg-[var(--docs-surface-muted)] shadow-soft overflow-hidden min-h-[28rem]">
                <%~ stati.partials.tabTypescript({ active: true }) %>
                <%~ stati.partials.tabIsg %>
                <%~ stati.partials.tabTemplates %>
                <%~ stati.partials.tabRouting %>
                <%~ stati.partials.tabMarkdown %>
            </div>
        </div>
    </div>
</section>
