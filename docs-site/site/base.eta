<%
/**
 * Page Shell
 *
 * The document around both layouts: layout.eta (docs pages) and home.eta (the
 * homepage) call stati.layout('base'), and what they render arrives here as
 * stati.body.
 *
 * Props:
 *   - fonts (optional): Files in public/fonts/ to preload, in order
 *     (default: Inter, then Archivo)
 */
const fonts = stati.props?.fonts ?? ['inter', 'archivo'];
%>
<!DOCTYPE html>
<html lang="<%= stati.site.defaultLocale || 'en-US' %>" data-theme="light">
<head>
    <%~ stati.include('partials/scripts/themeInit') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="view-transition" content="same-origin">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

<% for (const font of fonts) { %>
    <link rel="preload" href="<%= `/fonts/${font}.woff2` %>" as="font" type="font/woff2" crossorigin>
<% } %>

    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/prism-stati.css">
    <link rel="alternate" type="application/rss+xml" title="Stati Documentation Updates" href="/feed.xml">
<% if (stati.assets?.bundlePaths && stati.assets.bundlePaths.length > 0) { _%>
<% for (const bundlePath of stati.assets.bundlePaths) { %>
    <link rel="modulepreload" href="<%= bundlePath %>">
<% } _%>
<% } _%>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <%~ stati.include('partials/sections/header') %>

    <%~ stati.body %>

    <%~ stati.include('partials/sections/footer') %>
    <%~ stati.include('partials/components/searchTemplates') %>
</body>
</html>
