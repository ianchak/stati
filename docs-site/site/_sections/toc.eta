<%
/**
 * Table of Contents Section
 *
 * Server-rendered from stati.page.toc. Lists h2 and h3 headings only, so long
 * reference pages stay scannable. The label is not a heading, keeping the
 * document outline intact. src/docs/toc.ts adds scroll-spy.
 */

const entries = (stati.page.toc || []).filter((entry) => entry.level <= 3);
%>
<% if (entries.length >= 2) { %>
<nav id="toc" class="sticky top-header max-h-[calc(100vh-4rem)] overflow-y-auto py-10 pl-2 pr-4" aria-labelledby="toc-label">
    <p id="toc-label" class="mb-3 text-xs font-semibold uppercase tracking-wider text-faint">On this page</p>
    <ul id="toc-nav" class="space-y-0.5 border-l border-line">
        <% for (const entry of entries) { %>
        <li><a href="<%= `#${entry.id}` %>" class="<%= stati.propValue('toc-link -ml-px border-l border-transparent', entry.level === 3 ? 'pl-6' : 'pl-3') %>" data-target="<%= entry.id %>"><%= entry.text %></a></li>
        <% } %>
    </ul>
</nav>
<% } %>
