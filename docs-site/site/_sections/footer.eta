<%
/**
 * Footer Section
 *
 * Site footer with brand, documentation links, community links, and resources.
 * Uses footerBrand, footerSection, link, and icon components.
 */

const footerSections = [
  {
    title: 'Documentation',
    icon: 'book',
    links: [
      { href: '/core-concepts/overview/', text: 'Core Concepts' },
      { href: '/configuration/file/', text: 'Configuration' },
      { href: '/api/reference/', text: 'API Reference' },
      { href: '/faq/', text: 'FAQ' },
    ]
  },
  {
    title: 'Community',
    icon: 'users',
    links: [
      { href: '/advanced/contributing/', text: 'Contributing' },
      { href: 'https://github.com/ianchak/stati', text: 'GitHub Repository', external: true },
      { href: 'https://github.com/ianchak/stati/issues', text: 'Report Issues', external: true },
      { href: 'https://github.com/ianchak/stati/discussions', text: 'Discussions', external: true },
    ]
  },
  {
    title: 'Resources',
    icon: 'cube',
    links: [
      { href: '/cli/commands/', text: 'CLI Reference' },
      { href: '/advanced/topics/', text: 'Advanced Usage' },
      { href: '/glossary/', text: 'Glossary' },
      { href: '/information/ai-policy/', text: 'AI Policy' },
    ]
  }
];
%>
<footer class="bg-white/80 dark:bg-dark-900/80 backdrop-blur-xl border-t border-gray-200/60 dark:border-dark-700/60 shadow-2xl shadow-gray-900/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
            <!-- Brand -->
            <%~ stati.partials.footerBrand %>

            <!-- Link Sections -->
            <% footerSections.forEach(section => { %>
                <%~ stati.partials.footerSection({
                    title: section.title,
                    icon: section.icon,
                    links: section.links
                }) %>
            <% }) %>
        </div>

        <div class="border-t border-gray-200/60 dark:border-dark-700/60 mt-12 pt-8">
            <div class="flex flex-col lg:flex-row justify-between items-center space-y-4 lg:space-y-0">
                <div class="flex items-center space-x-2">
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        © <%= new Date().getFullYear() %> Stati. Built with
                    </p>
                    <span class="text-primary-600 dark:text-primary-400">❤️</span>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        and
                    </p>
                    <span class="inline-flex items-center px-2 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 text-xs font-medium rounded-md">
                        <%~ stati.partials.icon({ name: 'code-bracket', size: 'xs', class: 'mr-1', strokeWidth: 1.5 }) %>
                        TypeScript
                    </span>
                </div>
                <div class="flex items-center space-x-4 text-sm text-gray-500 dark:text-gray-400">
                    <div class="flex items-center space-x-2">
                        <div class="w-2 h-2 bg-primary-500 rounded-full"></div>
                        <span>Generated with Stati v<%= stati.generator.version %></span>
                    </div>
                    <div class="hidden lg:flex items-center space-x-2">
                        <%~ stati.partials.icon({ name: 'bolt', size: 'xs' }) %>
                        <span>Static output - typed config - ISG cache</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
