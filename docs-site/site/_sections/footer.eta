<%
/**
 * Footer Section
 *
 * Plain link columns plus the canonical one-line description and the real
 * Stati version this site was built with.
 */

const columns = [
  {
    title: 'Documentation',
    links: [
      { href: '/getting-started/introduction', text: 'Introduction' },
      { href: '/getting-started/quick-start', text: 'Quick Start' },
      { href: '/core-concepts/overview', text: 'Core Concepts' },
      { href: '/configuration/file', text: 'Configuration' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { href: '/api/reference', text: 'API Reference' },
      { href: '/cli/commands', text: 'CLI Commands' },
      { href: '/faq', text: 'FAQ' },
      { href: '/glossary', text: 'Glossary' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: 'https://github.com/ianchak/stati', text: 'GitHub', external: true },
      { href: 'https://www.npmjs.com/package/@stati/core', text: 'npm', external: true },
      { href: 'https://github.com/ianchak/stati/issues', text: 'Issues', external: true },
      { href: '/feed.xml', text: 'RSS feed' },
      { href: '/information/ai-policy', text: 'AI & Content Policy' },
    ],
  },
];
%>
<footer class="border-t border-line">
    <div class="mx-auto grid max-w-page gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
        <div>
            <a href="/" class="inline-flex items-center gap-2 rounded-md" aria-label="Stati home">
                <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span class="font-display text-lg font-extrabold">Stati</span>
            </a>
            <p class="mt-3 max-w-xs text-sm leading-6 text-muted">A TypeScript-first static site generator. MIT licensed.</p>
            <p class="mt-4 text-xs text-faint">This site is built with Stati v<%= stati.generator.version %>.</p>
        </div>
        <% columns.forEach(column => { %>
        <nav aria-label="<%= column.title %>">
            <p class="text-sm font-semibold text-ink"><%= column.title %></p>
            <ul class="mt-3 space-y-2">
                <% column.links.forEach(link => { %>
                <li>
                    <a href="<%= link.href %>" class="text-sm text-muted transition-colors duration-150 hover:text-ink"<% if (link.external) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= link.text %><% if (link.external) { %><span class="sr-only"> (opens in a new tab)</span><% } %></a>
                </li>
                <% }) %>
            </ul>
        </nav>
        <% }) %>
    </div>
</footer>
