<%
/**
 * Footer Section Component
 *
 * A footer link section with icon header and list of links.
 *
 * Props:
 *   - title (required): Section title
 *   - icon (required): Icon name for the section header
 *   - links (required): Array of { href, text, external? } objects
 *
 * Usage:
 *   <%~ stati.partials.footerSection({
 *     title: 'Documentation',
 *     icon: 'book',
 *     links: [
 *       { href: '/core-concepts/overview/', text: 'Core Concepts' },
 *       { href: '/api/reference/', text: 'API Reference' }
 *     ]
 *   }) %>
 */

// Guard for standalone rendering - this partial is only used as a callable
if (!stati.props) { %><% return; } %>
<%
const { title, icon, links } = stati.props;
%>
<div>
    <div class="flex items-center space-x-2 mb-6">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-500/10 dark:bg-primary-400/20">
            <%~ stati.partials.icon({ name: icon, size: 'sm', class: 'text-primary-600 dark:text-primary-400', strokeWidth: 1.5 }) %>
        </div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
            <%= title %>
        </h3>
    </div>
    <ul class="space-y-3 text-sm">
        <% links.forEach(link => { %>
        <li>
            <%~ stati.partials.link({
                href: link.href,
                text: link.text,
                showDot: false,
                external: link.external
            }) %>
        </li>
        <% }) %>
    </ul>
</div>
