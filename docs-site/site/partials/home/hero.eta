<%
/**
 * Hero Section (Homepage)
 *
 * Positioning headline, lede, the copyable install command, honest specs,
 * and a real stati.config.ts. Content lives in index.md front matter.
 */

const hero = stati.page.hero;
%>
<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-page px-4 pb-20 pt-12 sm:px-6 lg:pb-24 lg:pt-16">
        <h1 id="hero-title" class="reveal max-w-[17ch] font-display text-[clamp(2.4rem,1.2rem+4.1vw,4.6rem)] font-extrabold leading-[1.02] text-ink [font-stretch:116%] lg:max-w-none">
            <%= hero.title %>
        </h1>

        <div class="mt-8 grid grid-cols-1 items-center gap-12 lg:mt-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
        <div>
            <p class="reveal max-w-[34rem] text-lg leading-8 text-muted" style="--delay: 80ms"><%= hero.lede %></p>

            <div class="reveal mt-9 max-w-md" style="--delay: 160ms">
                <%~ stati.include('../components/commandLine', { id: 'hero-command', command: hero.command }) %>
            </div>

            <div class="reveal mt-5 flex flex-wrap items-center gap-3" style="--delay: 220ms">
                <a href="/getting-started/quick-start" class="btn btn-secondary">
                    Read the quick start
                    <%~ stati.include('../components/icon', { name: 'arrow-right', size: 'sm' }) %>
                </a>
                <a href="https://github.com/ianchak/stati" class="btn text-muted hover:text-ink" target="_blank" rel="noopener noreferrer">
                    <%~ stati.include('../components/icon', { name: 'github', size: 'sm' }) %>
                    GitHub<span class="sr-only"> (opens in a new tab)</span>
                </a>
            </div>

            <ul class="reveal mt-10 grid grid-cols-2 gap-x-5 gap-y-2 font-mono text-xs text-faint sm:flex sm:flex-wrap" style="--delay: 280ms" aria-label="At a glance">
                <% hero.specs.forEach((spec, i) => { %>
                <li class="flex items-center gap-5"><% if (i > 0) { %><span class="hidden h-3 w-px bg-line-strong sm:block" aria-hidden="true"></span><% } %><%= spec %></li>
                <% }) %>
            </ul>
        </div>

        <div class="reveal-panel min-w-0" style="--delay: 200ms">
            <%~ stati.include('../components/codePanel', { id: 'hero-config', file: 'stati.config.ts', lang: 'typescript', code: hero.config }) %>
        </div>
        </div>
    </div>
</section>
