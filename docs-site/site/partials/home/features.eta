<%
/**
 * Feature Inventory (Homepage)
 *
 * Every built-in feature, grouped by job, each linking to its reference
 * page. A typographic index rather than cards, so the whole set reads at a
 * glance. Content lives in index.md front matter.
 */

const inventory = stati.page.inventory;
const total = inventory.groups.reduce((sum, group) => sum + group.items.length, 0);
%>
<section id="features" class="border-b border-line" aria-labelledby="features-title">
    <div class="mx-auto max-w-page px-4 py-20 sm:px-6 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end">
            <h2 id="features-title" class="font-display text-[clamp(2rem,1.4rem+2vw,3rem)] font-extrabold leading-[1.05] [font-stretch:115%]"><%= inventory.title %></h2>
            <p class="max-w-xl text-lg leading-8 text-muted lg:justify-self-end"><%= inventory.lede %></p>
        </div>

        <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 xl:grid-cols-4">
            <% inventory.groups.forEach(group => { %>
            <div>
                <h3 class="border-b border-ink pb-3 text-sm font-semibold text-ink">
                    <%= group.title %>
                </h3>
                <ul class="grid grid-cols-2 gap-x-4 sm:block">
                    <% group.items.forEach(item => { %>
                    <li class="border-b border-line">
                        <a href="<%= item.href %>" class="group block py-3 sm:py-3.5">
                            <span class="flex items-center justify-between gap-3 font-medium text-ink group-hover:text-accent-ink">
                                <%= item.name %>
                                <%~ stati.include('../components/icon', { name: 'arrow-right', size: 'xs', class: 'flex-none text-faint opacity-40 transition-[opacity,transform] duration-150 group-hover:translate-x-0.5 group-hover:text-accent-ink group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100' }) %>
                            </span>
                            <span class="sr-only text-sm leading-6 text-muted sm:not-sr-only sm:mt-1 sm:block"><%= item.text %></span>
                        </a>
                    </li>
                    <% }) %>
                </ul>
            </div>
            <% }) %>
        </div>

        <p class="mt-10 font-mono text-xs text-faint"><%= total %> features across @stati/core, @stati/cli, create-stati and the optional @stati/images</p>
    </div>
</section>
