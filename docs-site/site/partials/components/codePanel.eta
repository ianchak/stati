<%
/**
 * Code Panel Component
 *
 * A framed, build-time highlighted code sample with a filename bar and a
 * copy button. Highlighting comes from the `highlight` helper in stati.config.ts.
 *
 * Props:
 *   - id (required): Unique id for the code element (used by the copy button)
 *   - code (required): Source code
 *   - lang (required): Prism language id ('typescript', 'bash', 'markdown', 'ejs')
 *   - file (optional): Label shown in the bar (e.g. 'stati.config.ts')
 *   - class (optional): Extra classes for the outer frame
 *   - ticks (optional): false to omit corner ticks when a parent stack carries them
 *
 * Usage:
 *   <%~ stati.include('partials/components/codePanel', { id: 'hero-config', file: 'stati.config.ts', lang: 'typescript', code: snippet }) %>
 */

const { id, code, lang, file } = stati.props;
%>
<figure class="<%= stati.propValue(stati.props.ticks !== false && 'ticks', 'code-panel m-0', stati.props.class) %>">
    <figcaption class="code-panel-bar">
        <span class="truncate"><%= file || lang %></span>
        <button type="button" class="copy-button -my-1" data-copy-target="<%= id %>" aria-label="<%= `Copy ${file || 'code'}` %>"><span data-copy-label>Copy</span></button>
    </figcaption>
    <pre class="<%= `language-${lang}` %>"><code id="<%= id %>" class="<%= `language-${lang}` %>"><%~ stati.helpers.highlight(code, lang) %></code></pre>
</figure>
