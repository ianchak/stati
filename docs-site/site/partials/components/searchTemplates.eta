<%
/**
 * Search Dialog
 *
 * Native <dialog> driven by src/core/search/search-dialog.ts. Rendered on
 * every page; result rows and state messages are cloned from <template>s.
 */

const suggestions = [
  { href: '/getting-started/quick-start', text: 'Quick start' },
  { href: '/configuration/file', text: 'Configuration file' },
  { href: '/core-concepts/isg', text: 'Incremental Static Generation' },
  { href: '/core-concepts/templates', text: 'Templates & layouts' },
  { href: '/cli/commands', text: 'CLI commands' },
];
%>
<dialog id="search-dialog" class="search-dialog m-0 h-full max-h-none w-full max-w-none bg-canvas p-0 text-ink backdrop:bg-ink/40 sm:mx-auto sm:mt-[12vh] sm:h-auto sm:max-h-[70vh] sm:w-[min(40rem,calc(100vw-2rem))] sm:rounded-xl sm:border sm:border-line-strong" aria-labelledby="search-label">
    <div class="flex h-full flex-col sm:max-h-[70vh]">
        <div class="flex items-center gap-3 border-b border-line px-4">
            <%~ stati.include('./icon', { name: 'search', size: 'md', class: 'flex-none text-faint' }) %>
            <label id="search-label" for="search-input" class="sr-only">Search the documentation</label>
            <input id="search-input" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results" placeholder="Search docs" autocomplete="off" spellcheck="false" class="h-14 min-w-0 flex-1 bg-transparent text-base text-ink placeholder:text-faint focus-visible:outline-none [&::-webkit-search-cancel-button]:hidden">
            <button type="button" class="rounded-md border border-line px-2 py-1 text-xs font-medium text-muted hover:text-ink" data-search-close>
                <span class="hidden sm:inline">Esc</span><span class="sm:hidden">Close</span>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto overscroll-contain">
            <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>

            <div class="px-4 py-4" data-search-idle>
                <p class="px-2 text-xs font-medium text-faint">Popular pages</p>
                <ul class="mt-2">
                    <% suggestions.forEach(item => { %>
                    <li><a href="<%= item.href %>" class="block rounded-md px-2 py-2 text-sm text-muted hover:bg-raised hover:text-ink"><%= item.text %></a></li>
                    <% }) %>
                </ul>
            </div>

            <div class="px-6 py-8 text-sm" data-search-message hidden></div>

            <ul id="search-results" role="listbox" aria-label="Search results" class="p-2"></ul>
        </div>

        <div class="hidden items-center gap-4 border-t border-line px-4 py-2.5 text-xs text-faint sm:flex">
            <span><kbd class="font-mono">↑</kbd> <kbd class="font-mono">↓</kbd> to move</span>
            <span><kbd class="font-mono">Enter</kbd> to open</span>
            <span><kbd class="font-mono">Esc</kbd> to close</span>
        </div>
    </div>
</dialog>

<template id="search-result-template">
    <li role="none">
        <a role="option" aria-selected="false" class="block rounded-lg px-3 py-2.5 aria-selected:bg-accent-wash">
            <span class="block text-sm font-medium text-ink" data-result-heading></span>
            <span class="mt-0.5 block truncate text-xs text-faint" data-result-breadcrumb></span>
            <span class="mt-1 line-clamp-2 block text-[13px] leading-5 text-muted" data-result-snippet></span>
        </a>
    </li>
</template>

<template id="search-loading-template">
    <p class="text-muted">Searching…</p>
</template>

<template id="search-empty-template">
    <p class="font-medium text-ink">No results for “<span data-search-query></span>”</p>
    <p class="mt-1 text-muted">Try a shorter or different term, or start from one of these:</p>
    <ul class="mt-3 flex flex-wrap gap-2">
        <% suggestions.slice(0, 3).forEach(item => { %>
        <li><a href="<%= item.href %>" class="inline-block rounded-md border border-line px-2.5 py-1 text-muted hover:border-line-strong hover:text-ink"><%= item.text %></a></li>
        <% }) %>
    </ul>
</template>

<template id="search-error-template">
    <p class="font-medium text-ink">Search couldn’t load</p>
    <p class="mt-1 text-muted">Check your connection and reopen search. You can still browse from the sidebar or the <a href="/getting-started/introduction" class="text-accent-ink underline underline-offset-2">introduction</a>.</p>
</template>
